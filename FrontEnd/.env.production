# .env.production — Vite production build environment variables
# ================================================================
# These values are BAKED INTO the JS bundle at build time.
# 
# INTEGRATED DEPLOYMENT (Backend serves Frontend):
# - Frontend is served from the same domain as the backend
# - API calls use relative URLs (/api) - no CORS issues
# - AI service still needs absolute URL (different service)
# ================================================================

# Spring Boot backend API (same domain, relative URL)
VITE_API_BASE_URL=/api

# FastAPI AI service URL (healthcare-ai on Render)
# Update this to your actual Render AI service URL
VITE_AI_API_BASE_URL=https://healthcare-ai.onrender.com
