# .env.production — Vite production build environment variables
# ================================================================
# These values are BAKED INTO the JS bundle at build time.
# For Render deployment, set these as Environment Variables in the
# Render Dashboard (Static Site → Environment) OR in render.yaml.
#
# ⚠️  Update these URLs to match your actual Render service names:
#     Go to each service in Render → Settings → copy the .onrender.com URL
# ================================================================

# Spring Boot backend service URL (healthcare-backend on Render)
VITE_API_BASE_URL=https://healthcare-backend.onrender.com/api

# FastAPI AI service URL (healthcare-ai on Render)
VITE_AI_API_BASE_URL=https://healthcare-ai.onrender.com
