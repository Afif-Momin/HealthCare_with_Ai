# .env.production — Vite production build environment variables
# ================================================================
# Values here are BAKED INTO the JS bundle at build time.
#
# Leave these EMPTY to enable runtime host detection (recommended for EC2):
#   - Spring Boot backend  → <current-host>:8080/api
#   - FastAPI AI service   → <current-host>:8000
#   - If the backend serves the frontend (integrated mode) the API
#     base auto-resolves to a relative "/api" with no CORS friction.
#
# To pin to a specific URL (custom domain / reverse proxy), set values
# below before running `npm run build`:
#
#   VITE_API_BASE_URL=https://api.yourdomain.com/api
#   VITE_AI_API_BASE_URL=https://ai.yourdomain.com
# ================================================================

VITE_API_BASE_URL=
VITE_AI_API_BASE_URL=
