# ╔══════════════════════════════════════════════════════════════════╗
# ║  INTEGRATED DOCKERFILE — Spring Boot + React Frontend           ║
# ║                                                                ║
# ║  This Dockerfile builds both the React frontend and Spring Boot ║
# ║  backend, then serves the frontend static files from Spring Boot║
# ║                                                                ║
# ║  FOR RENDER DEPLOYMENT: Optimized for 512MB RAM free tier      ║
# ╚══════════════════════════════════════════════════════════════════╝

# -------- STAGE 1: Build React Frontend --------
FROM node:20-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY FrontEnd/package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy frontend source
COPY FrontEnd/ ./

# Build frontend (Vite will use VITE_* env vars if available)
ARG VITE_API_BASE_URL=/api
ARG VITE_AI_API_BASE_URL=https://healthcare-ai.onrender.com
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_AI_API_BASE_URL=${VITE_AI_API_BASE_URL}

RUN npm run build

# -------- STAGE 2: Build Spring Boot Backend --------
FROM maven:3.9.5-eclipse-temurin-17 AS backend-build

WORKDIR /backend

# Copy pom.xml first for better layer caching
COPY BackEnd/pom.xml ./
RUN mvn dependency:go-offline -B

# Copy backend source
COPY BackEnd/src ./src

# Copy frontend build output to Spring Boot static resources
COPY --from=frontend-build /frontend/dist ./src/main/resources/static

# Build Spring Boot application (includes frontend static files)
RUN mvn clean package -DskipTests -q

# -------- STAGE 3: Runtime Image --------
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# JVM flags tuned for Render free tier (512 MB hard limit)
ENV JAVA_OPTS="-Xmx256m -Xms64m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+UseStringDeduplication -Djava.security.egd=file:/dev/./urandom"

# Copy built jar from backend build stage
COPY --from=backend-build /backend/target/*.jar app.jar

# Expose port (Render will inject PORT env var)
EXPOSE 8080

# Note: Health check removed - Render handles this via healthCheckPath in render.yaml
# The PORT variable is not available during image build, only at runtime

# Start Spring Boot (serves both API and frontend)
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
